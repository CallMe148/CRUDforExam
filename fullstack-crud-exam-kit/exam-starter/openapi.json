                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "title",
                  "author",
                  "price",
                  "category_id"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "author": {
                    "type": "string",
                    "maxLength": 150
                  },
                  "price": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 99999999.99,
                    "multipleOf": 0.01
                  },
                  "category_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "cover": {
                    "type": "string",
                    "format": "binary",
                    "description": "PNG/JPEG/WebP, maximum 2 MB"
                  },
                  "remove_cover": {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ],
                    "description": "PUT only: remove existing cover if no new cover"
                  }
                }
              }
            }
          }
        }
